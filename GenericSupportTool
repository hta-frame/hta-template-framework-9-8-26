' ============================================================
' Log handling (persisted to EmailLog.csv next to this HTA)
' ============================================================
Function ScriptFolder
    Dim p
    p = document.location.pathname
    p = Replace(p, "/", "\")
    If Left(p, 1) = "\" Then p = Mid(p, 2)
    ScriptFolder = Left(p, InStrRev(p, "\"))
End Function

Sub InitLog
    On Error Resume Next
    gLogFilePath = ScriptFolder() & "EmailLog.csv"
    gNextLogID = 1

    If Not gFso.FileExists(gLogFilePath) Then
        Dim newFile
        Set newFile = gFso.CreateTextFile(gLogFilePath, True)
        newFile.WriteLine "LogID,TicketNumber,AgentName,AgentEmail,Timestamp"
        newFile.Close
        Exit Sub
    End If

    ' Read every line into memory first. We still need to scan the WHOLE
    ' file once to find the highest LogID so new entries keep numbering
    ' correctly, but only today's rows get inserted into the DOM table
    ' below -- that DOM insert (not the file read) is what made startup
    ' get slower the longer this file was in use.
    Dim f, line, maxID, allLines(), lineCount
    maxID = 0
    lineCount = 0
    ReDim allLines(1000)
    Set f = gFso.OpenTextFile(gLogFilePath, 1) ' ForReading
    If Not f.AtEndOfStream Then f.ReadLine ' skip header
    Do While Not f.AtEndOfStream
        line = f.ReadLine
        If Trim(line) <> "" Then
            If lineCount > UBound(allLines) Then ReDim Preserve allLines(UBound(allLines) + 1000)
            allLines(lineCount) = line
            lineCount = lineCount + 1
        End If
    Loop
    f.Close

    ' Single pass over every line: (1) find the highest LogID across the
    ' WHOLE file regardless of date, so new entries keep numbering
    ' correctly even across day boundaries, and (2) collect just today's
    ' rows (by the Timestamp field) for display -- only today's assignments
    ' are relevant for "who's been assigned what so far today," and
    ' showing yesterday's (or older) entries just adds clutter/confusion
    ' about what's still open. MAX_LOG_ROWS_SHOWN is kept as a safety cap
    ' in case an unusually high number of urgents come in on one day.
    Dim i, parts, todayIdx(), todayCount, startIdx
    ReDim todayIdx(lineCount)
    todayCount = 0
    For i = 0 To lineCount - 1
        parts = ParseCsvLine(allLines(i))
        If UBound(parts) >= 4 Then
            If IsNumeric(parts(0)) Then
                If CLng(parts(0)) > maxID Then maxID = CLng(parts(0))
            End If
            If IsDate(parts(4)) Then
                If DateValue(parts(4)) = Date Then
                    todayIdx(todayCount) = i
                    todayCount = todayCount + 1
                End If
            End If
        End If
    Next
    gNextLogID = maxID + 1

    startIdx = 0
    If todayCount > MAX_LOG_ROWS_SHOWN Then startIdx = todayCount - MAX_LOG_ROWS_SHOWN
    For i = startIdx To todayCount - 1
        parts = ParseCsvLine(allLines(todayIdx(i)))
        AddLogRow parts(0), parts(1), parts(2), parts(3), parts(4)
    Next
End Sub

Sub LogEmail(ticketNum, agentName, agentEmail)
    On Error Resume Next
    Dim f, line, ts
    ts = Now
    line = CsvEscapeField(gNextLogID) & "," & CsvEscapeField(ticketNum) & "," & _
           CsvEscapeField(agentName) & "," & CsvEscapeField(agentEmail) & "," & CsvEscapeField(ts)

    Set f = gFso.OpenTextFile(gLogFilePath, 8, True) ' ForAppending
    f.WriteLine line
    f.Close

    AddLogRow gNextLogID, ticketNum, agentName, agentEmail, ts
    gNextLogID = gNextLogID + 1
End Sub

Sub AddLogRow(logID, ticketNum, agentName, agentEmail, ts)
    On Error Resume Next
    Dim tbody, row
    Set tbody = document.getElementById("logBody")

    ' Using createElement("tr") + innerHTML is unreliable in the HTA/old-IE
    ' rendering engine -- table rows/cells must be built with insertRow/insertCell.
    ' Inserting at index 0 (instead of -1/append) puts every new row above
    ' the previous ones, so the table always reads newest-first -- both
    ' when replaying today's history in chronological order at startup
    ' (each older row gets pushed down as a newer one is added above it)
    ' and when a brand-new entry is logged live during the session (it
    ' lands at the very top, since it's newer than everything already
    ' shown).
    Set row = tbody.insertRow(0)
    row.insertCell(-1).innerText = logID
    row.insertCell(-1).innerText = ticketNum
    row.insertCell(-1).innerText = agentName
    row.insertCell(-1).innerText = agentEmail
    row.insertCell(-1).innerText = ts
End Sub

