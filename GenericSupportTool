    ClearError document.getElementById("ctrlTicket1")
    ClearError document.getElementById("ctrlAgent")
    document.getElementById("err1").style.display = "none"
End Sub

Sub ValidateAndSend1
    On Error Resume Next
    Dim hasError
    hasError = False
    ResetErrors1

    Dim ctrlID, ctrlTicket, ctrlAgent
    Set ctrlID = document.getElementById("ctrlID")
    Set ctrlTicket = document.getElementById("ctrlTicket1")
    Set ctrlAgent = document.getElementById("ctrlAgent")

    If Trim(ctrlID.value) = "" Then
        MarkError ctrlID
        hasError = True
    End If
    If Trim(ctrlTicket.value) = "" Then
        MarkError ctrlTicket
        hasError = True
    End If
    If ctrlAgent.value = "" Then
        MarkError ctrlAgent
        hasError = True
    End If

    If hasError Then
        document.getElementById("err1").innerText = "Please fill in all required fields (highlighted in red)."
        document.getElementById("err1").style.display = "block"
        Exit Sub
    End If

    Dim agentOption, agentEmail, agentName
    Set agentOption = ctrlAgent.options(ctrlAgent.selectedIndex)
    agentEmail = ctrlAgent.value
    agentName = agentOption.getAttribute("data-name")

    ' The email goes to the ticket owner identified by "Enter ID", PLUS the
    ' selected agent's email (from the Choose Agent dropdown) -- both go on
    ' the "To" line, semicolon-separated, so the agent is included on the
    ' email they've been assigned to, not just named in the body text.
    ' ctrlID.value is passed to Outlook as-is (no domain appended) so
    ' Outlook resolves it against Active Directory/the GAL.
    Dim recipientEmail
    recipientEmail = ctrlID.value & ";" & agentEmail

    Dim subj, body
    subj = "URGENT: Ticket #" & ctrlTicket.value & " - ID " & ctrlID.value
    body = "<p>Greetings,</p>" & _
           "<p>Your help desk ticket, " & ctrlTicket.value & ", has been assigned to the following agent: " & agentName & ".</p>" & _
           "<p>" & agentName & " should contact you shortly regarding your issue. The best way to contact the agent is through Microsoft Teams or email.</p>" & _
           "<p>The queue manager will review the ticket and may contact you to appropriately evaluate the priority of this issue.</p>" & _
           "<p>Have a nice day!</p>"

    If SendViaOutlook(recipientEmail, "", subj, body, "", Array()) Then
        LogEmail ctrlTicket.value, agentName, agentEmail
        document.getElementById("status1").innerText = "Email draft opened and logged."
        ctrlID.value = ""
        ctrlTicket.value = ""
        ctrlAgent.selectedIndex = 0
    End If
End Sub

' ============================================================
' Log handling (persisted to EmailLog.csv next to this HTA)
' ============================================================
Function ScriptFolder
    Dim p
    p = document.location.pathname
    p = Replace(p, "/", "\")
    If Left(p, 1) = "\" Then p = Mid(p, 2)
    ScriptFolder = Left(p, InStrRev(p, "\"))
End Function

Sub InitLog
    On Error Resume Next
    gLogFilePath = ScriptFolder() & "EmailLog.csv"
    gNextLogID = 1

    If Not gFso.FileExists(gLogFilePath) Then
        Dim newFile
        Set newFile = gFso.CreateTextFile(gLogFilePath, True)
        newFile.WriteLine "LogID,TicketNumber,AgentName,AgentEmail,Timestamp"
        newFile.Close
        Exit Sub
    End If

    Dim f, line, parts, maxID
    maxID = 0
    Set f = gFso.OpenTextFile(gLogFilePath, 1) ' ForReading
    If Not f.AtEndOfStream Then f.ReadLine ' skip header
    Do While Not f.AtEndOfStream
        line = f.ReadLine
        If Trim(line) <> "" Then
            parts = Split(line, ",")
            If UBound(parts) >= 4 Then
                AddLogRow parts(0), parts(1), parts(2), parts(3)
                If CLng(parts(0)) > maxID Then maxID = CLng(parts(0))
            End If
        End If
    Loop
    f.Close
    gNextLogID = maxID + 1
End Sub

Sub LogEmail(ticketNum, agentName, agentEmail)
    On Error Resume Next
    Dim f, line, ts
    ts = Now
    line = gNextLogID & "," & ticketNum & "," & agentName & "," & agentEmail & "," & ts

    Set f = gFso.OpenTextFile(gLogFilePath, 8, True) ' ForAppending
    f.WriteLine line
    f.Close

    AddLogRow gNextLogID, ticketNum, agentName, agentEmail
    gNextLogID = gNextLogID + 1
End Sub

Sub AddLogRow(logID, ticketNum, agentName, agentEmail)
    On Error Resume Next
    Dim tbody, row
    Set tbody = document.getElementById("logBody")

    ' Using createElement("tr") + innerHTML is unreliable in the HTA/old-IE
    ' rendering engine -- table rows/cells must be built with insertRow/insertCell.
    Set row = tbody.insertRow(-1)
    row.insertCell(-1).innerText = logID
    row.insertCell(-1).innerText = ticketNum
    row.insertCell(-1).innerText = agentName
    row.insertCell(-1).innerText = agentEmail
End Sub

