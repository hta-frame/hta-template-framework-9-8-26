' (search for them to rename the buttons).
Dim Tab5TemplateFile, Tab6TemplateFile, Tab7TemplateFile
Tab5TemplateFile = "Templates\{{TAB5_TEMPLATE_FILE}}.oft" ' <<< CHANGE ME: your .oft file name
Tab6TemplateFile = "Templates\{{TAB6_TEMPLATE_FILE}}.oft" ' <<< CHANGE ME: your .oft file name
Tab7TemplateFile = "Templates\{{TAB7_TEMPLATE_FILE}}.oft" ' <<< CHANGE ME: your .oft file name
' NewTabFunctionality -- END: Tabs 5-7 template file config

' ---- Category 2 (Severity Templates): names, descriptions, and who to email ----
' One line per template (Category 2, slots 1-5). Each line sets three
