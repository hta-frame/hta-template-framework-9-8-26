    Dim hasError
    hasError = False
    ResetErrors1

    Dim ctrlID, ctrlTicket, ctrlAgent
    Set ctrlID = document.getElementById("ctrlID")
    Set ctrlTicket = document.getElementById("ctrlTicket1")
    Set ctrlAgent = document.getElementById("ctrlAgent")

