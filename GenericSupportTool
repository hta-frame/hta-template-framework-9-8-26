Tab2ToEmails = "recipient1@example.com;recipient2@example.com;recipient3@example.com;recipient4@example.com;recipient5@example.com" ' placeholder To recipients for Tab 2 emails
Tab2CcEmails = "cc1@example.com;cc2@example.com;cc3@example.com;cc4@example.com;cc5@example.com" ' placeholder CC recipients for Tab 2 emails

' NewTabFunctionality -- START: Tab 3 templates folder config
' ---- Tab 3 email templates folder ----------------------------------
' Tab 3 (Category 1) lists every Outlook template (.oft) in this folder
' in its dropdown. The list is re-read every time Tab 3 is opened (or
' "Refresh List" is clicked), so just drop new .oft files in the folder
' -- no need to edit this file. Picking one opens it in Outlook.
' %APPDATA% expands to the current user's AppData\Roaming folder
' (e.g. C:\Users\<name>\AppData\Roaming), so this works on any PC.
Dim TemplatesFolder
TemplatesFolder = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%APPDATA%\Microsoft\Templates")
' NewTabFunctionality -- END: Tab 3 templates folder config

' NewTabFunctionality -- START: Tab 4 template file config
