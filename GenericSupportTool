' NewTabFunctionality -- START: TAB 3 (Category 1) -- Email Templates
' ============================================================
' The dropdown is rebuilt from the .oft files in TemplatesFolder every
' time Tab 3 is shown, so adding/removing/renaming a template in that
' folder shows up without touching this file. Selecting a template opens
' it in Outlook via CreateItemFromTemplate + Display (a draft, not sent).
Dim gPendingTemplatePath ' NewTabFunctionality -- path of the template being opened (read by FinishOpenTemplate)

' NewTabFunctionality -- LoadTemplateList: fills the dropdown with every
' .oft file found in TemplatesFolder (name shown, full path as the value).
Sub LoadTemplateList
    On Error Resume Next
    Dim sel, folder, f, opt, n
    Set sel = document.getElementById("ctrlTemplate")

    ' Keep the "-- Select Template --" placeholder (index 0), drop the rest.
    Do While sel.options.length > 1
        sel.remove 1
    Loop
    sel.selectedIndex = 0

    document.getElementById("tab3Folder").innerText = TemplatesFolder
    If Not gFso.FolderExists(TemplatesFolder) Then
        document.getElementById("tab3Count").innerText = "Folder not found"
        Exit Sub
    End If

    n = 0
    Set folder = gFso.GetFolder(TemplatesFolder)
    For Each f In folder.Files
        If LCase(gFso.GetExtensionName(f.Name)) = "oft" Then
            Set opt = document.createElement("OPTION")
            opt.text = gFso.GetBaseName(f.Name)
            opt.value = f.Path
            sel.options.add opt
            n = n + 1
        End If
    Next

    If n = 1 Then
        document.getElementById("tab3Count").innerText = "1 template"
    Else
        document.getElementById("tab3Count").innerText = n & " templates"
    End If
End Sub

' NewTabFunctionality -- OpenTemplatesFolder: opens TemplatesFolder in
' Windows Explorer so new .oft files can be dropped in.
Sub OpenTemplatesFolder
    On Error Resume Next
    If Not gFso.FolderExists(TemplatesFolder) Then
        MsgBox "Templates folder not found: " & TemplatesFolder
        Exit Sub
    End If
    CreateObject("WScript.Shell").Run "explorer.exe """ & TemplatesFolder & """"
End Sub

' NewTabFunctionality -- OpenSelectedTemplate: runs when a template is
' picked in the dropdown (onchange).
' Same "please wait" deferral as BeginSend/FinishSend -- launching Outlook
' can freeze the UI for several seconds, so paint the status first.
Sub OpenSelectedTemplate
    On Error Resume Next
    Dim sel
    Set sel = document.getElementById("ctrlTemplate")
    If sel.value = "" Then Exit Sub
    If gSendInProgress Then Exit Sub
    gSendInProgress = True

    gPendingTemplatePath = sel.value
    document.body.style.cursor = "wait"
    document.getElementById("status3").style.color = "#666"
    document.getElementById("status3").innerText = "Opening template in Outlook -- please wait..."

    window.setTimeout "FinishOpenTemplate", 30
End Sub

' NewTabFunctionality -- FinishOpenTemplate: does the actual Outlook work
' (CreateItemFromTemplate + Display), then updates the status message.
Sub FinishOpenTemplate
    On Error Resume Next
    Dim objOutlook, objMail, ok
    ok = False

    If Not gFso.FileExists(gPendingTemplatePath) Then
        MsgBox "Template not found (it may have been moved or deleted):" & vbCrLf & gPendingTemplatePath
        LoadTemplateList
    Else
        Err.Clear
        Set objOutlook = CreateObject("Outlook.Application")
        If Err.Number <> 0 Then
            MsgBox "Could not connect to Outlook. Is it installed?"
        Else
            Err.Clear
            Set objMail = objOutlook.CreateItemFromTemplate(gPendingTemplatePath)
            If Err.Number <> 0 Then
                MsgBox "Could not open template:" & vbCrLf & gPendingTemplatePath & vbCrLf & vbCrLf & Err.Description
            Else
                objMail.Display
                ok = True
            End If
        End If
        Set objMail = Nothing
        Set objOutlook = Nothing
    End If

    gSendInProgress = False
    document.body.style.cursor = "default"
    document.getElementById("status3").style.color = "#2e7d32"
    If ok Then
        document.getElementById("status3").innerText = "Template opened: " & gFso.GetBaseName(gPendingTemplatePath)
    Else
        document.getElementById("status3").innerText = ""
    End If

    ' Reset so picking the same template again still fires onchange.
    document.getElementById("ctrlTemplate").selectedIndex = 0
End Sub
