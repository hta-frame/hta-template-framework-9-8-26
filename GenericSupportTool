        MarkError ctrlID
        hasError = True
    End If
    If Trim(ctrlTicket.value) = "" Then
        MarkError ctrlTicket
        hasError = True
    End If
    If ctrlAgent.value = "" Then
        MarkError ctrlAgent
        hasError = True
    End If

    If hasError Then
        document.getElementById("err1").innerText = "Please fill in all required fields (highlighted in red)."
        document.getElementById("err1").style.display = "block"
        Exit Sub
    End If

    Dim agentOption, agentEmail, agentName
    Set agentOption = ctrlAgent.options(ctrlAgent.selectedIndex)
    agentEmail = ctrlAgent.value
    agentName = agentOption.getAttribute("data-name")

    ' The email goes to the ticket owner identified by "Enter ID", PLUS the
    ' selected agent's email (from the Choose Agent dropdown) -- both go on
    ' the "To" line, semicolon-separated, so the agent is included on the
    ' email they've been assigned to, not just named in the body text.
    ' ctrlID.value is passed to Outlook as-is (no domain appended) so
    ' Outlook resolves it against Active Directory/the GAL.
    Dim recipientEmail
    recipientEmail = ctrlID.value & ";" & agentEmail

    Dim subj, body
    subj = "URGENT: Ticket #" & ctrlTicket.value & " - ID " & ctrlID.value
    body = "<p>Greetings,</p>" & _
           "<p>Your help desk ticket, " & EscapeHtml(ctrlTicket.value) & ", has been assigned to the following agent: " & EscapeHtml(agentName) & ".</p>" & _
           "<p>" & EscapeHtml(agentName) & " should contact you shortly regarding your issue. The best way to contact the agent is through Microsoft Teams or email.</p>" & _
           "<p>The queue manager will review the ticket and may contact you to appropriately evaluate the priority of this issue.</p>" & _
           "<p>Have a nice day!</p>"

    gTab1PendingTicket = ctrlTicket.value
    gTab1PendingAgentName = agentName
    gTab1PendingAgentEmail = agentEmail
    BeginSend "tab1", "status1", recipientEmail, Tab1CcEmail, subj, body, "", Array()
End Sub

' ============================================================
' START: GeneratePassDown -- copies a shift-handoff summary (an optional
' note plus the last 5 rows already shown in the Agent Log table) to the
' clipboard, so it can be pasted into Teams or any other chat tool.
' ============================================================
' Reads straight from the on-screen table (tbody#logBody) rather than
' re-reading EmailLog.csv, since the table is already the up-to-date,
' today-only, newest-first view the agent is looking at -- its first 5
' rows ARE "the last 5 assigned urgent tickets" by construction (see
' AddLogRow's insertRow(0), which keeps the newest entry on top).
Sub GeneratePassDown
    On Error Resume Next

    Dim noteText
    noteText = InputBox("Add a note for the next agent (optional) -- it gets included in the copied pass-down text below the ticket list:", "Pass Down Information")

    Dim tbody, rowCount, maxRows
    Set tbody = document.getElementById("logBody")
    rowCount = tbody.rows.Length
    maxRows = 5
    If rowCount < maxRows Then maxRows = rowCount

    Dim txt
    txt = "PASS DOWN INFORMATION -- " & Now & vbCrLf & vbCrLf

    If Trim(noteText) <> "" Then
        txt = txt & "Note: " & noteText & vbCrLf & vbCrLf
    End If

    txt = txt & "Last " & maxRows & " Assigned Urgent Ticket(s):" & vbCrLf

    If maxRows = 0 Then
        txt = txt & "  (no urgent tickets assigned yet today)" & vbCrLf
    Else
        Dim i, row, cells
        For i = 0 To maxRows - 1
            Set row = tbody.rows(i)
            Set cells = row.cells
            txt = txt & "  - Ticket " & cells(1).innerText & " | Agent: " & cells(2).innerText & _
                  " (" & cells(3).innerText & ") | " & cells(4).innerText & vbCrLf
        Next
    End If

    Err.Clear
    window.clipboardData.setData "Text", txt

    If Err.Number <> 0 Then
        MsgBox "Could not copy to clipboard: " & Err.Description
    Else
        document.getElementById("status1").innerText = "Pass-down info copied to clipboard -- paste it into Teams or wherever it's needed."
    End If
End Sub
' ============================================================
' END: GeneratePassDown
