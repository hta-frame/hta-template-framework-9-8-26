' Basic deterrent only -- this file is plain text, so anyone can open it in
' Notepad and read this password (or just delete the check). Not real security.
Dim DevNotesPassword
DevNotesPassword = "changeme123"

Dim gLogFilePath, gNextLogID, gFso, gLastPanelID
Set gFso = CreateObject("Scripting.FileSystemObject")
gLastPanelID = "tab1"

' The on-screen log table only ever shows TODAY's rows (see InitLog) -- this
' constant is just a safety cap on top of that, in case an unusually high
' number of urgents came in on a single day, so a runaway day still can't
' make startup slow by re-inserting an unbounded number of DOM rows. The
' full history for every day still lives in EmailLog.csv (open it in Excel
' to see everything); only the on-screen table is limited.
Const MAX_LOG_ROWS_SHOWN = 200

' ============================================================
' START: File location helpers
' ============================================================
' AppFilePath: the full path of this running .hta, e.g.
' "C:\Tools\Generic_Engagement_Tool.hta". It's read from the HTA's own
' command line, which (unlike document.location) handles spaces and
' \\server paths correctly. document.location is only a fallback.
Function AppFilePath
    On Error Resume Next
    Dim cmd, pos, p
    cmd = GenericSupportToolHTA.commandLine
    pos = InStr(LCase(cmd), ".hta")
    If pos > 0 Then
        p = Trim(Left(cmd, pos + 3))
        If Left(p, 1) = """" Then p = Mid(p, 2)
    Else
        ' Fallback: build the path from the page address instead.
        p = unescape(Replace(document.location.pathname, "/", "\"))
        If Left(p, 1) = "\" And Mid(p, 3, 1) = ":" Then p = Mid(p, 2)
    End If
    AppFilePath = p
End Function
' ============================================================
' END: File location helpers
' ============================================================

' ============================================================
' START: Automatic update check
' ============================================================
' ReadShareVersion: reads the version number from version.txt on the
' share (first line only, spaces trimmed). Returns "" if the file can't
' be read -- for example when the share is offline.
Function ReadShareVersion(versionPath)
    On Error Resume Next
    ReadShareVersion = ""
    If Not gFso.FileExists(versionPath) Then Exit Function
    ReadShareVersion = Trim(Replace(gFso.OpenTextFile(versionPath, 1).ReadLine, vbTab, ""))
    If Err.Number <> 0 Then ReadShareVersion = ""
End Function

' IsCompleteCode: a safety check on the code file before it's used.
' If the file is empty, half-pasted, or the wrong file, the update is
' skipped and the tool keeps running its current version. It must have
' the HTA header at the start, the version line, and </html> at the end.
Function IsCompleteCode(code)
    Dim c
    c = LCase(code)
    IsCompleteCode = (InStr(c, "<hta:application") > 0) And _
                     (InStr(c, "const app_version = """) > 0) And _
                     (InStr(c, "</html>") > 0)
End Function

' StampVersion: writes the number from version.txt into the new code's
' APP_VERSION line. That way you only ever change the number in ONE
' place (version.txt), and the copy that gets installed always shows
' the right "Current version" -- so it won't try to update again.
Function StampVersion(code, ver)
    Dim re
    Set re = New RegExp
    re.Pattern = "Const APP_VERSION = ""[^""]*"""
    re.Global = False ' only the first match -- the real setting at the top
    StampVersion = re.Replace(code, "Const APP_VERSION = """ & ver & """")
End Function

' SharePath: the full path of a file inside UpdateShareFolder.
' Adds the "\" between folder and file name if the share path
' doesn't end with one, so the path works with or without it.
Function SharePath(fileName)
    Dim folder
    folder = UpdateShareFolder
    If Right(folder, 1) <> "\" Then folder = folder & "\"
    SharePath = folder & fileName
End Function

' SyncIcon: the window icon (AppIcon.ico) is a separate file that has
' to sit in the same folder as the .hta. The updater only replaces the
' .hta, so a folder without the icon would show no icon. This copies
' it from the share if it's missing (an existing icon is never
' replaced). Windows reads the icon when the tool opens, so a newly
' copied icon shows from the next time it's opened.
Sub SyncIcon
    On Error Resume Next
    Dim myFolder, localIcon, shareIcon
    myFolder = Left(AppFilePath(), InStrRev(AppFilePath(), "\"))
    localIcon = myFolder & UpdateIconFile
    shareIcon = SharePath(UpdateIconFile)
    If gFso.FileExists(localIcon) Then Exit Sub      ' already has an icon
    If Not gFso.FileExists(shareIcon) Then Exit Sub  ' share offline / no icon there
    gFso.CopyFile shareIcon, localIcon, False
End Sub

' CheckForUpdate: runs first thing at startup (see Window_OnLoad).
' Returns True if the new code was installed. In that case this window
' is closing and the user opens the updated tool again.
' Any problem along the way (share offline, no permission, bad code
' file) quietly leaves the current version running. Nothing is lost.
Function CheckForUpdate
    CheckForUpdate = False
    If UpdateShareFolder = "" Then Exit Function ' updates turned off

    On Error Resume Next
    Dim versionPath, codePath, myPath, tempPath, shareVer, newCode, ts
    versionPath = SharePath(UpdateVersionFile)
    codePath = SharePath(UpdateCodeFile)
    myPath = AppFilePath()
    If myPath = "" Then Exit Function

    ' Make sure this folder has the window icon (copies it if missing).
    SyncIcon

    ' Step 1: what version does version.txt say?
    shareVer = ReadShareVersion(versionPath)
    If shareVer = "" Then Exit Function              ' share offline / no version.txt
    If InStr(shareVer, """") > 0 Then Exit Function   ' a " would break the version line
    If shareVer = APP_VERSION Then Exit Function     ' same version -- nothing to do
    ' (Any DIFFERENT number counts, so you can also roll back to an
    ' older version by putting the old code and number back.)

    ' Step 2: read the complete new code from the share.
    If Not gFso.FileExists(codePath) Then Exit Function
    newCode = gFso.OpenTextFile(codePath, 1).ReadAll
    If Err.Number <> 0 Then Exit Function
    If Not IsCompleteCode(newCode) Then Exit Function ' empty / half-pasted / wrong file

    ' Step 3: write the version.txt number into the new code.
    newCode = StampVersion(newCode, shareVer)

    ' Step 4: save the new code next to this file under a temporary
    ' name first. If anything fails here, only the temp file is affected
    ' and the working copy is untouched.
    tempPath = myPath & ".updating"
    Set ts = gFso.CreateTextFile(tempPath, True)
    ts.Write newCode
    ts.Close
    If Err.Number <> 0 Then gFso.DeleteFile tempPath, True : Exit Function

    ' Step 5: replace this .hta with the new code.
    gFso.CopyFile tempPath, myPath, True
    If Err.Number <> 0 Then gFso.DeleteFile tempPath, True : Exit Function
    gFso.DeleteFile tempPath, True

    ' Step 6: tell the user, then close. The user opens the tool again
    ' (double-click) to get the new version. The tool doesn't reopen
    ' itself, because on Windows 11 a window the tool reopens by itself
    ' shows no icon on the taskbar. One opened by the user does.
    MsgBox "The tool was updated to version " & shareVer & "." & vbCrLf & _
           "Please open it again.", vbInformation, "Update installed"
    CheckForUpdate = True
    self.close
End Function

' ShowAppVersion: shows "Current version X.XX" under the title, and the
' version + share folder in the Developer Notes.
Sub ShowAppVersion
    On Error Resume Next
    document.getElementById("appVersion").innerText = APP_VERSION
    document.getElementById("devNotesVersion").innerText = APP_VERSION
    document.getElementById("devNotesShare").innerText = UpdateShareFolder
End Sub
' ============================================================
' END: Automatic update check
' ============================================================

' ============================================================
' START: CsvEscapeField / ParseCsvLine -- proper CSV quoting.
' ============================================================
' EmailLog.csv fields (ticket number, agent name) are free text a user
' typed in, and could contain a comma (e.g. a pasted ticket number like
' "1,234") or a quote. Writing them with a plain "&" join and reading them
' back with plain Split(line, ",") -- the original approach -- silently
' shifts every column after the first comma, corrupting that row (and
' every row's LogID/ticket/agent columns look wrong afterward). These two
' functions implement minimal RFC-4180-style CSV quoting so that no longer
' happens.
Function CsvEscapeField(s)
    s = CStr(s)
    If InStr(s, ",") > 0 Or InStr(s, """") > 0 Or InStr(s, vbCr) > 0 Or InStr(s, vbLf) > 0 Then
        s = Replace(s, """", """""")
        CsvEscapeField = """" & s & """"
    Else
        CsvEscapeField = s
    End If
End Function

Function ParseCsvLine(line)
    Dim result(), count, i, ch, cur, inQuotes
    count = 0
    ReDim result(10)
    cur = ""
    inQuotes = False
    i = 1
    Do While i <= Len(line)
        ch = Mid(line, i, 1)
        If inQuotes Then
            If ch = """" Then
                If i < Len(line) And Mid(line, i + 1, 1) = """" Then
                    cur = cur & """"
                    i = i + 1
                Else
                    inQuotes = False
                End If
            Else
                cur = cur & ch
            End If
        Else
            If ch = """" Then
                inQuotes = True
            ElseIf ch = "," Then
                result(count) = cur
                count = count + 1
                If count > UBound(result) Then ReDim Preserve result(UBound(result) + 10)
                cur = ""
            Else
                cur = cur & ch
            End If
        End If
        i = i + 1
    Loop
    result(count) = cur
    ReDim Preserve result(count)
    ParseCsvLine = result
End Function
' ============================================================
' END: CsvEscapeField / ParseCsvLine
' ============================================================

' ============================================================
' START: EscapeHtml / NlToBr -- make free-typed/pasted text safe to drop
' into an HTML email body.
' ============================================================
' Without this, a pasted error message or log snippet containing "<", ">"
' or "&" (stack traces, generics like List<String>, XML/HTML snippets --
' all common in support tickets) gets interpreted as real markup by
' Outlook's renderer and can silently vanish or mangle part of the email.
Function EscapeHtml(s)
    s = CStr(s)
    s = Replace(s, "&", "&amp;")
    s = Replace(s, "<", "&lt;")
    s = Replace(s, ">", "&gt;")
    EscapeHtml = s
End Function

' Converts line breaks to <br> tags. Handles CRLF (\r\n, what a Windows
' textarea normally produces when the user presses Enter), and also lone
' LF or lone CR (common in text pasted from web forms/non-Windows
' sources) -- the original code only handled CRLF, so pasted multi-line
' text using bare \n silently lost its line breaks and ran together as
' one paragraph in the generated email.
Function NlToBr(s)
    s = CStr(s)
    s = Replace(s, vbCrLf, vbLf)
    s = Replace(s, vbCr, vbLf)
    s = Replace(s, vbLf, "<br>")
    NlToBr = s
End Function
' ============================================================
' END: EscapeHtml / NlToBr
' ============================================================

' ============================================================
' START: LoadSignature -- reads the user's signature straight off disk,
' instead of asking Outlook for it or relying on the registry.
' ============================================================
'
' Why this exists: the normal way to get the signature is to let Outlook
' insert it on its own -- Display() opens the compose window, then the
' script reads objMail.HTMLBody (which by then already has the signature
' in it) and prepends its own text to that. Some organizations' policy
' blocks that: HTMLBody never picks up the signature, no matter how long
' the script waits, so the email goes out blank or signature-less.
'
' An earlier version of this function read the registry
' (HKCU\Software\Microsoft\Office\<version>\Common\MailSettings\NewSignature)
' to find which signature is the default for new messages, then read that
' signature's .htm file. That registry value is only ever set if someone
' has explicitly chosen a "New messages" signature in classic Outlook's
' Signature settings -- on a machine where that was never done (or where
' the primary mail client is the separate "Outlook for Windows" app, which
' doesn't write to this key at all), NewSignature is simply absent, so the
' old function always returned "" even though real signature files exist
' on disk. This version skips the registry entirely and just looks
' directly in the Signatures folder.
'
' Outlook ALWAYS writes every signature to a plain .htm file on disk, at:
'     %APPDATA%\Microsoft\Signatures\<Signature Name>.htm
' If there's more than one .htm file there (one per named signature),
' there's no registry-free way to know which one is "the" default, so this
' picks whichever one was modified most recently -- the signature someone
' actually edited/picked last is a reasonable simple proxy for "the one
' currently in use." If that guess is ever wrong for a particular setup,
' either remove the unwanted .htm file(s) from the Signatures folder, or
' hardcode a specific filename here instead of scanning.
'
' Returns: the signature as an HTML string, ready to append to another
' email's body (just the inside of its <body>...</body>, so we don't end
' up nesting a second <html>/<head> inside the message). Returns "" if no
' .htm signature file can be found -- callers should treat that as "no
' signature," not an error; the email still works fine, it just won't
' have one.
Function LoadSignature()
    On Error Resume Next
    LoadSignature = ""

    Dim sigPath, folder, file, newestFile, newestTime
    sigPath = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Signatures"
    If Not gFso.FolderExists(sigPath) Then Exit Function

    Set folder = gFso.GetFolder(sigPath)
    newestTime = 0
    For Each file In folder.Files
        If LCase(gFso.GetExtensionName(file.Name)) = "htm" Then
            If CDbl(file.DateLastModified) > newestTime Then
                newestTime = CDbl(file.DateLastModified)
                Set newestFile = file
            End If
        End If
    Next
    If newestFile Is Nothing Then Exit Function ' no .htm signature file found

    ' Read with ADODB.Stream rather than FileSystemObject, so accented
    ' letters and other non-ASCII characters in the signature come through
    ' correctly -- FSO's plain text reader assumes the system codepage and
    ' can mangle them.
    '
    ' Detect the file's own declared charset instead of assuming UTF-8
    ' (fixed 2026-09-11): Word/Outlook actually write these files in the
    ' SYSTEM's ANSI codepage -- on this machine (and likely most Western
    ' Windows installs) that's windows-1252, NOT UTF-8, despite what an
    ' earlier version of this function assumed. Reading a windows-1252
    ' file as UTF-8 corrupts every accented character (an "e" with an
    ' accent came back as "?" instead of the real letter). ISO-8859-1 is
    ' used for this first, safe peek because it maps every byte 1:1 to a
    ' character with no risk of a decode error regardless of the file's
    ' real encoding -- and the <meta charset=...> declaration itself is
    ' always plain ASCII, which reads back identically whether the probe
    ' charset is ISO-8859-1, UTF-8, or windows-1252.
    Dim probeStream, probeText, detectedCharset, reCharset
    Set probeStream = CreateObject("ADODB.Stream")
    probeStream.Type = 2 ' adTypeText
    probeStream.Charset = "iso-8859-1"
    probeStream.Open
    probeStream.LoadFromFile newestFile.Path
    probeText = probeStream.ReadText
    probeStream.Close

    detectedCharset = "windows-1252" ' sensible default if no charset is declared
    Set reCharset = New RegExp
    reCharset.Pattern = "charset=([a-zA-Z0-9\-_]+)"
    reCharset.IgnoreCase = True
    If reCharset.Test(probeText) Then
        detectedCharset = reCharset.Execute(probeText)(0).SubMatches(0)
    End If

    Dim stream, rawHtml
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2 ' adTypeText
    Err.Clear
    stream.Charset = detectedCharset
    If Err.Number <> 0 Then
        Err.Clear
        stream.Charset = "windows-1252" ' detected name wasn't one ADODB recognizes -- fall back
    End If
    stream.Open
    stream.LoadFromFile newestFile.Path
    rawHtml = stream.ReadText
    stream.Close

    ' Signatures saved by Word define their font/size/spacing through CSS
    ' classes (p.MsoNormal, etc.) in <style> block(s) inside <head> -- the
    ' <body> markup itself is just bare <p class=MsoNormal>...</p> with no
    ' inline styling at all. An earlier version of this function grabbed
    ' ONLY the <body>...</body> contents and discarded those <style>
    ' blocks, so the pasted-in signature lost its font/size/margins and
    ' fell back to whatever default styling the surrounding email
    ' happened to use -- an unwanted formatting CHANGE, not a fix. To make
    ' the signature look EXACTLY like it does in the .htm file, every
    ' <style> block from <head> is carried over verbatim, immediately
    ' followed by the <body> contents, in the same order as the source
    ' file. Nothing here is reformatted, added, or removed -- it's the
    ' file's own style rules and its own body markup, reassembled.
    Dim re, m, styles
    styles = ""
    Set re = New RegExp
    re.Pattern = "<style[^>]*>[\s\S]*?<\/style>"
    re.IgnoreCase = True
    re.Global = True
    If re.Test(rawHtml) Then
        For Each m In re.Execute(rawHtml)
            styles = styles & m.Value
        Next
    End If

    Dim bodyHtml
    re.Global = False
    re.Pattern = "<body[^>]*>([\s\S]*)<\/body>"
    If re.Test(rawHtml) Then
        bodyHtml = re.Execute(rawHtml)(0).SubMatches(0)
    Else
        bodyHtml = rawHtml ' couldn't find a <body> tag -- fall back to the whole file
    End If

    LoadSignature = styles & bodyHtml
End Function
' ============================================================
' END: LoadSignature
' ============================================================

' ============================================================
' START: SendViaOutlook -- builds a complete Outlook draft (body,
' signature, recipients, attachments) and displays it for review.
' ============================================================
Function SendViaOutlook(strTo, strCc, strSubject, strBodyHtml, strAttachmentPath, arrExtraAttachments)
    On Error Resume Next
    Dim objOutlook, objMail
    SendViaOutlook = False

    Set objOutlook = CreateObject("Outlook.Application")
    If Err.Number <> 0 Then
        MsgBox "Could not connect to Outlook. Is it installed?"
        Exit Function
    End If

    Set objMail = objOutlook.CreateItem(0) ' olMailItem

    ' Force HTML format explicitly. If the Outlook profile's default
    ' compose format is Plain Text or Rich Text (common under a corporate
    ' policy/DLP setting), setting .HTMLBody below has no visible effect --
    ' the compose window keeps rendering the plain-text Body, and the
    ' draft appears completely blank even though HTMLBody was "set"
    ' successfully. Forcing olFormatHTML (2) here guarantees HTMLBody is
    ' actually what gets displayed and edited.
    objMail.BodyFormat = 2 ' olFormatHTML

    ' Build the whole body ourselves -- our own content plus the signature
    ' from LoadSignature() -- instead of relying on Outlook to insert the
    ' signature after the fact. This also means we no longer need to open
    ' the compose window first and wait/race for HTMLBody to be ready
    ' before touching it: everything below can be set before Display().
    objMail.HTMLBody = strBodyHtml & LoadSignature()

    objMail.To = strTo
    If strCc <> "" Then objMail.CC = strCc
    objMail.Subject = strSubject

    ' NOTE: we deliberately do NOT call objMail.Recipients.ResolveAll here.
    ' Programmatic access to Recipients can trigger Outlook's "Object Model
    ' Guard" security prompt (some antivirus/Outlook configs show a "program
    ' is trying to access..." warning). If that dialog opens off-screen or
    ' behind another window, this synchronous call blocks forever and
    ' freezes the whole single-threaded HTA -- including tab switching,
    ' since nothing else can run until the hidden dialog is dismissed. To/CC
    ' still resolve normally (on their own) once the user clicks into the
    ' field or hits Send -- there's no safe way to force that early.

    ' Track any attachment path that no longer points to a real file (moved,
    ' renamed, or deleted since the user picked it) instead of just skipping
    ' it -- silently sending the email without it means the user has no way
    ' to know it's missing until whoever receives it asks where it is.
    Dim missingAttachments
    missingAttachments = ""

    If Trim(strAttachmentPath) <> "" Then
        If gFso.FileExists(strAttachmentPath) Then
            objMail.Attachments.Add strAttachmentPath
        Else
            missingAttachments = missingAttachments & gFso.GetFileName(strAttachmentPath) & vbCrLf
        End If
    End If

    ' arrExtraAttachments holds additional attachment paths (e.g. Tab 2's
    ' "Add Attachments" queue), since Attachments.Add only takes one path
    ' per call. Pass Array() when there are none.
    Dim i
    For i = LBound(arrExtraAttachments) To UBound(arrExtraAttachments)
        If Trim(arrExtraAttachments(i)) <> "" Then
            If gFso.FileExists(arrExtraAttachments(i)) Then
                objMail.Attachments.Add arrExtraAttachments(i)
            Else
                missingAttachments = missingAttachments & gFso.GetFileName(arrExtraAttachments(i)) & vbCrLf
            End If
        End If
    Next

    If missingAttachments <> "" Then
        MsgBox "The following attachment(s) could not be found and were NOT added to this email " & _
               "(they may have been moved, renamed, or deleted since you selected them):" & vbCrLf & vbCrLf & _
               missingAttachments, vbExclamation, "Missing Attachment(s)"
    End If

    ' Everything (body, signature, recipients, attachments) is already
    ' filled in, so Display() now just shows the finished draft -- no more
    ' waiting on Outlook's own signature-loading timing.
    objMail.Display

    Set objMail = Nothing
    Set objOutlook = Nothing

    SendViaOutlook = True
End Function
' ============================================================
' END: SendViaOutlook
' ============================================================

' ============================================================
' START: BeginSend / FinishSend -- deferred send with a "please wait"
' indicator.
' ============================================================
' CreateObject("Outlook.Application") launches Outlook if it isn't already
' running, which can take several seconds -- and since HTA/VBScript is
' single-threaded, the ENTIRE UI is unresponsive for that whole time with
' no visual sign anything is happening, which reads as a crash/freeze to
' a normal user. There is no real threading available here, so this can't
' be made non-blocking, but we can at least show a wait cursor + status
' message before the blocking call starts. That only works if the message
' actually gets painted first: setting DOM/style properties does not
' repaint until the current script yields back to the browser's message
' loop, so BeginSend sets the "please wait" state, then uses
' window.setTimeout to defer the actual send (FinishSend) to the next
' tick -- giving the engine a chance to paint before the blocking call
' begins.
Dim gPendingKind, gPendingSevIdx, gPendingStatusID
Dim gPendingTo, gPendingCc, gPendingSubj, gPendingBody, gPendingAttach, gPendingExtraAttach
Dim gTab1PendingTicket, gTab1PendingAgentName, gTab1PendingAgentEmail
Dim gSendInProgress
gSendInProgress = False

Sub BeginSend(kind, statusID, strTo, strCc, strSubject, strBodyHtml, strAttachmentPath, arrExtraAttachments)
    On Error Resume Next

    ' The 30ms deferral below is enough time for a user to click a second
    ' Generate/Send button before the first send finishes -- guard against
    ' that overwriting the pending state out from under the first send.
    If gSendInProgress Then Exit Sub
    gSendInProgress = True

    gPendingKind = kind
    gPendingStatusID = statusID
    gPendingTo = strTo
    gPendingCc = strCc
    gPendingSubj = strSubject
    gPendingBody = strBodyHtml
    gPendingAttach = strAttachmentPath
    gPendingExtraAttach = arrExtraAttachments

    document.body.style.cursor = "wait"
    document.getElementById(statusID).style.color = "#666"
    document.getElementById(statusID).innerText = "Opening Outlook -- please wait..."

    window.setTimeout "FinishSend", 30
End Sub

Sub FinishSend
    On Error Resume Next
    Dim ok
    ok = SendViaOutlook(gPendingTo, gPendingCc, gPendingSubj, gPendingBody, gPendingAttach, gPendingExtraAttach)

    gSendInProgress = False
    document.body.style.cursor = "default"
    document.getElementById(gPendingStatusID).style.color = "#2e7d32"

    Select Case gPendingKind
        Case "tab1"
            If ok Then
                LogEmail gTab1PendingTicket, gTab1PendingAgentName, gTab1PendingAgentEmail
                document.getElementById("status1").innerText = "Email draft opened and logged."
                document.getElementById("ctrlID").value = ""
                document.getElementById("ctrlTicket1").value = ""
                document.getElementById("ctrlAgent").selectedIndex = 0
            Else
                document.getElementById("status1").innerText = ""
            End If

        Case "tab2"
            If ok Then
                document.getElementById("status2").innerText = "Email draft opened."
                document.getElementById("ctrlTicket2").value = ""
                document.getElementById("ctrlProblem").value = ""
                document.getElementById("ctrlUserID").value = ""
                document.getElementById("ctrlErrorMsg").value = ""
                document.getElementById("ctrlDetails").value = ""
                document.getElementById("ctrlOriginalTicket").value = ""
                ClearTab2Attachments
            Else
                document.getElementById("status2").innerText = ""
            End If

        Case "sev"
            Dim idx2
            idx2 = gPendingSevIdx
            If ok Then
                document.getElementById("svStatus" & idx2).innerText = "Email draft opened."
                document.getElementById("svTicket" & idx2).value = ""
                document.getElementById("svError" & idx2).value = ""
                document.getElementById("svListTickets" & idx2).value = ""
                document.getElementById("svLogText" & idx2).value = ""
                document.getElementById("svLocation" & idx2).value = ""
                document.getElementById("svLogFile" & idx2).value = ""
                document.getElementById("svListCount" & idx2).innerText = "0 tickets"
            Else
                document.getElementById("svStatus" & idx2).innerText = ""
            End If
    End Select
End Sub
' ============================================================
' END: BeginSend / FinishSend
' ============================================================

