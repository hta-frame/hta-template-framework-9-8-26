<script language="VBScript">

' ============================================================
' Version & automatic updates
' ============================================================
' THE SHARED FOLDER HOLDS TWO FILES
'   version.txt                 -> one line: the current version, e.g. 1.01
'   EngagementTool_Code.txt     -> the COMPLETE code of the .hta
'
' HOW UPDATES WORK
'   Every time this tool opens, it reads version.txt from the share.
'   If that number is different from this copy's version (shown at the
'   top of the tool as "Current version X.XX"), it replaces ALL of this
'   .hta's code with EngagementTool_Code.txt, then asks the user to open it again.
'   If the share can't be reached (offline, VPN down, no access) the
'   tool just opens as normal on its current version.
'
' TO RELEASE AN UPDATE
'   1. Paste the complete new code into EngagementTool_Code.txt and save.
'   2. Change the number in version.txt (e.g. 1.00 -> 1.01) and save.
'   That's it. Every copy, in any folder, updates the next time it opens.
'   (You don't need to edit the version below by hand -- the updater
'   writes the number from version.txt into the new copy for you.)
'   Always save the code file BEFORE changing version.txt, so nobody
'   picks up a half-saved file.
'
' WHAT AN UPDATE DOES NOT TOUCH
'   Only this .hta file is replaced. EmailLog.csv and the Templates
'   folder next to it are left alone, so each folder keeps its own log
'   history. Settings (email addresses etc.) are part of the code, so
'   they come from the code file like everything else.
'   The one exception: if this folder has no AppIcon.ico, it is copied
'   from the share (see SyncIcon), so the window icon shows up.

' This copy's version. Filled in automatically by the updater.
Const APP_VERSION = "1.01"

' The shared folder that holds version.txt and the code file.
' The "\" at the end is optional. Set it to "" to turn automatic updates off.
Const UpdateShareFolder = "\\YOUR-SERVER\YOUR-SHARE\EngagementTool\" ' <<< CHANGE ME: your share path

' The two file names inside UpdateShareFolder.
Const UpdateVersionFile = "version.txt"
Const UpdateCodeFile = "EngagementTool_Code.txt"

' The window icon. It must sit next to the .hta, so the updater copies
' it from UpdateShareFolder whenever this folder doesn't have one yet.
' Keep this name the same as ICON="..." in the HTA:APPLICATION tag.
Const UpdateIconFile = "AppIcon.ico"

' ============================================================
' Configuration -- edit these to match your environment
' ============================================================

