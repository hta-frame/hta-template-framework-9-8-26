'     from this .hta's folder; a full path (C:\... or \\server\...) also works.
Dim Tab4TemplateFile
Tab4TemplateFile = "Templates\{{TAB4_TEMPLATE_FILE}}.oft" ' <<< CHANGE ME: your .oft file name
' NewTabFunctionality -- END: Tab 4 template file config

' NewTabFunctionality -- START: Tabs 5-7 template file config
' ---- Tabs 5, 6 and 7 one-click templates ----------------------------
' These work exactly like Tab 4 above: each button opens its ONE .oft
