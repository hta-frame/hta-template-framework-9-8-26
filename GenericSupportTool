' NewTabFunctionality -- OneClickTemplatePath: turns a template file
' setting into a full path (relative paths are resolved from this .hta's folder).
Function OneClickTemplatePath(templateFile)
    If InStr(templateFile, ":") > 0 Or Left(templateFile, 2) = "\\" Then
        OneClickTemplatePath = templateFile
    Else
        OneClickTemplatePath = ScriptFolder() & templateFile
    End If
End Function

' Which template the button asked for. window.setTimeout can't pass
' values along, so OpenOneClickTemplate stores them here and
' FinishOpenOneClickTemplate reads them a moment later.
Dim gOneClickTemplatePath, gOneClickTemplateSetting

' NewTabFunctionality -- OpenOneClickTemplate: runs on button click.
' Same "please wait" deferral as OpenSelectedTemplate -- launching Outlook
' can freeze the UI for several seconds, so show the wait cursor first.
Sub OpenOneClickTemplate(templateFile, settingName)
    On Error Resume Next
    If gSendInProgress Then Exit Sub
    gSendInProgress = True
    gOneClickTemplatePath = OneClickTemplatePath(templateFile)
    gOneClickTemplateSetting = settingName
    document.body.style.cursor = "wait"
    window.setTimeout "FinishOpenOneClickTemplate", 30
End Sub

' NewTabFunctionality -- FinishOpenOneClickTemplate: does the actual Outlook
' work (CreateItemFromTemplate + Display -- a draft, not sent).
Sub FinishOpenOneClickTemplate
    On Error Resume Next
    Dim path, objOutlook, objMail
    path = gOneClickTemplatePath

    If Not gFso.FileExists(path) Then
        MsgBox "Template not found:" & vbCrLf & path & vbCrLf & vbCrLf & _
               "Set " & gOneClickTemplateSetting & " at the top of the script to your .oft file."
    Else
        Err.Clear
        Set objOutlook = CreateObject("Outlook.Application")
        If Err.Number <> 0 Then
            MsgBox "Could not connect to Outlook. Is it installed?"
        Else
            Err.Clear
            Set objMail = objOutlook.CreateItemFromTemplate(path)
            If Err.Number <> 0 Then
                MsgBox "Could not open template:" & vbCrLf & path & vbCrLf & vbCrLf & Err.Description
            Else
                objMail.Display
            End If
        End If
        Set objMail = Nothing
        Set objOutlook = Nothing
    End If

    gSendInProgress = False
    document.body.style.cursor = "default"
End Sub
