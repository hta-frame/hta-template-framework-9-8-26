' Attachment queue for Tab 2's form. Outlook's Attachments.Add only
' takes one path per call, so files are queued here (up to 10) and
' added one-by-one in SendViaOutlook via the arrExtraAttachments param.
Dim gTab2Attachments(9), gTab2AttachmentCount
gTab2AttachmentCount = 0

Sub AddTab2Attachment
    On Error Resume Next
    Dim ctrlFile, p
    Set ctrlFile = document.getElementById("ctrlTab2File")
    p = Trim(ctrlFile.value)
    If p = "" Then Exit Sub

    If Not gFso.FileExists(p) Then
        MsgBox "File not found: " & p
        Exit Sub
    End If
    If gTab2AttachmentCount >= 10 Then
        MsgBox "Maximum of 10 attachments."
        Exit Sub
    End If

    gTab2Attachments(gTab2AttachmentCount) = p
    gTab2AttachmentCount = gTab2AttachmentCount + 1
    ctrlFile.value = ""
    RefreshTab2AttachList
End Sub

Sub ClearTab2Attachments
    On Error Resume Next
    gTab2AttachmentCount = 0
    document.getElementById("ctrlTab2File").value = ""
    RefreshTab2AttachList
End Sub

Sub RefreshTab2AttachList
    On Error Resume Next
    Dim i, txt
    txt = ""
    For i = 0 To gTab2AttachmentCount - 1
        If txt <> "" Then txt = txt & "; "
        txt = txt & gFso.GetFileName(gTab2Attachments(i))
    Next
    If txt = "" Then txt = "No attachments added."
    document.getElementById("tab2AttachList").innerText = txt
End Sub

' Builds a properly-sized array (0 to gTab2AttachmentCount-1) to hand to
' SendViaOutlook -- gTab2Attachments itself is always dimensioned to 10.
Function GetTab2AttachmentArray
    On Error Resume Next
    Dim arr(), i
    If gTab2AttachmentCount > 0 Then
        ReDim arr(gTab2AttachmentCount - 1)
        For i = 0 To gTab2AttachmentCount - 1
            arr(i) = gTab2Attachments(i)
        Next
    Else
        arr = Array()
    End If
    GetTab2AttachmentArray = arr
End Function

