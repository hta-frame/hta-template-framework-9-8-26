' Live count of comma-separated ticket numbers typed into "List of Ticket"
Sub UpdateTicketCount(idx)
    On Error Resume Next
    Dim ctrl, parts, i, cnt
    Set ctrl = document.getElementById("svListTickets" & idx)
    parts = Split(ctrl.value, ",")
    cnt = 0
    For i = 0 To UBound(parts)
        If Trim(parts(i)) <> "" Then cnt = cnt + 1
    Next
    If cnt = 1 Then
        document.getElementById("svListCount" & idx).innerText = "1 ticket"
    Else
        document.getElementById("svListCount" & idx).innerText = cnt & " tickets"
    End If
End Sub

